# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env: it holds your database passwords.
#
# SITE14 uses Supabase as hosted PostgreSQL only. The API connects with a
# normal PostgreSQL connection string. Supabase Auth, the Data API (REST),
# RLS and Realtime are not used (school rule).
#
# Where to find a connection string: Supabase dashboard, your project,
# "Connect" button, "Session pooler". Replace [YOUR-PASSWORD] with the
# database password. Characters such as @ : / ? # % in the password must be
# URL-encoded (@ becomes %40). Do not use the "Direct connection" string: it
# needs IPv6, which most home networks do not have.

# Development database: your own Supabase project.
DATABASE_URL=postgresql://postgres.your-dev-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Test database: a second, empty Supabase project, used only by `npm test`.
# The tests delete everything in it. Label it once with: npm run db:mark-test
DATABASE_URL_TEST=postgresql://postgres.your-test-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# SSL: true (encrypt and verify the server), no-verify (encrypt only),
# false (a local PostgreSQL only). Do not put sslmode=... in the URLs above:
# it is ignored on purpose, SSL is set here only.
DATABASE_SSL=true

# Supabase CA certificate, to verify the server: Database settings,
# SSL Configuration, "Download certificate". Save it as shown (certs/ is not
# committed). A hosting provider can receive the certificate text instead.
DATABASE_SSL_CA=./certs/prod-ca-2021.crt

# Connections kept open by the API. The free Supabase pooler allows few.
DATABASE_POOL_MAX=5
